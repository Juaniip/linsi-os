# ==============================================================================
# LINSI-OS · Fase 1 — "El Núcleo"
# Fragmento de kconfig con el hardening que pide la guía. Se aplica sobre un
# x86_64_defconfig con `scripts/kconfig/merge_config.sh` (ver build-kernel.sh)
# y después se resuelve con `make olddefconfig`.
#
# Formato: "CONFIG_X=y" activa, "# CONFIG_X is not set" desactiva. Ambos son
# sintaxis válida de fragmento de kconfig (merge_config.sh los entiende).
# ==============================================================================

# ------------------------------------------------------------------------------
# Kernel Lockdown — "ni siquiera root puede modificar el código en memoria"
# ------------------------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# Modo "integrity": bloquea /dev/mem, kexec sin firmar, módulos sin firmar,
# hibernación, escritura de MSRs, etc. Es el modo recomendado para un
# laboratorio (permite algo de debugging). Si se quiere el máximo nivel
# (bloquea además lectura de memoria del kernel / tracing), cambiar a
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y en su lugar.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# Firma de módulos: sin esto, Lockdown en modo integrity no puede exigir
# módulos firmados. La clave se autogenera en el build (certs/signing_key.pem)
# salvo que se indique una propia — ver notas de Secure Boot más abajo.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_SYSTEM_REVOCATION_LIST=y

# ------------------------------------------------------------------------------
# KASLR — aleatorización de direcciones para evadir exploits
# ------------------------------------------------------------------------------
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# ------------------------------------------------------------------------------
# Recorte de superficie de ataque: DMA por puertos externos
# ------------------------------------------------------------------------------
# IOMMU activo por defecto: cualquier dispositivo con DMA (Thunderbolt, PCIe
# externo) queda confinado y no puede leer/escribir memoria arbitraria.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_AMD_IOMMU=y

# Puertos/controladores con DMA externo directo: fuera. Reduce la superficie
# de ataque tipo "Thunderclap" / DMA por FireWire.
# CONFIG_THUNDERBOLT is not set
# CONFIG_FIREWIRE is not set
# CONFIG_FIREWIRE_OHCI is not set
# CONFIG_FIREWIRE_NET is not set

# ------------------------------------------------------------------------------
# BTRFS integrado en el núcleo (gestión de snapshots)
# ------------------------------------------------------------------------------
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# Tests de sanidad de BTRFS: sólo sirven para desarrollo del propio FS, no
# para un kernel de producción/laboratorio.
# CONFIG_BTRFS_FS_RUN_SANITY_TESTS is not set

# ------------------------------------------------------------------------------
# EFI / arranque vía systemd-boot con Secure Boot
# ------------------------------------------------------------------------------
# El stub EFI permite que el propio bzImage sea ejecutado directamente por la
# firmware UEFI (lo que carga systemd-boot). El enrolado de la clave en el
# Secure Boot "db"/MOK y el firmado final del binario con sbsign se hacen en
# Fase 8 (ISO/instalador), una vez que exista el arbol de arranque completo.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Extras de hardening en memoria que acompañan bien a Lockdown (no eran un
# punto explícito de la guía, pero son estándar junto a KASLR/Lockdown y no
# tienen costo de compatibilidad relevante):
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y

# ==============================================================================
# Fase 3 — "El Escudo": soporte de KERNEL para SELinux, auditd, nftables y
# LUKS2/dm-crypt. Sin esto, las herramientas de espacio de usuario de Fase 3
# compilan perfecto pero no tienen contraparte real cuando el sistema arranca
# — por eso se agrega acá, ANTES de compilar esas herramientas, y hay que
# volver a correr build-kernel.sh (configure + build + modules) para que
# tome efecto. No se estaba usando hasta ahora porque Fase 1/2 no lo
# necesitaban.
# ==============================================================================

# ------------------------------------------------------------------------------
# SELinux — MAC (control de acceso obligatorio) además del Lockdown LSM que ya
# está activo. CONFIG_LSM es la lista ordenada de LSMs habilitados en tiempo
# de arranque (reemplazó al viejo "DEFAULT_SECURITY_*" hace años): se agrega
# "selinux" a la cadena que ya trae el defconfig, sin sacar landlock/lockdown/
# yama/bpf que vienen por defecto. _DEVELOP habilita el modo permissive
# (loguea en vez de bloquear) — conviene para un laboratorio mientras se
# prueba la política, se puede sacar más adelante para producción estricta.
# _BOOTPARAM permite "selinux=0" en el kernel cmdline como válvula de escape
# si algo sale mal con la política y hay que arrancar sin ella para arreglarlo.
# ------------------------------------------------------------------------------
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_SELINUX_SID2STR_CACHE_SIZE=256
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"

# ------------------------------------------------------------------------------
# auditd — auditoría inmutable. AUDITSYSCALL es lo que realmente engancha las
# syscalls (sin esto, auditd no tiene nada que auditar más que unos pocos
# eventos genéricos).
# ------------------------------------------------------------------------------
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ------------------------------------------------------------------------------
# nftables — Netfilter con backend nf_tables (no las tablas legacy de
# iptables). NF_TABLES_INET permite reglas de familia "inet" (ipv4+ipv6 en una
# sola tabla, el estilo moderno recomendado en vez de duplicar en ip/ip6).
# NF_CONNTRACK habilita firewall con estado (ct state established, etc.), que
# cualquier política de denegación-por-defecto seria necesita.
# ------------------------------------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y

# ------------------------------------------------------------------------------
# LUKS2 + dm-crypt — Argon2id en sí es 100% userspace (libargon2, vía
# cryptsetup: deriva la clave simétrica ANTES de dársela al kernel), así que
# acá no hace falta nada de Argon2 — sólo el device-mapper y el cifrado real
# del disco (aes-xts-plain64 es el default de LUKS2). AES_NI_INTEL es
# aceleración por hardware — sin esto, cifrar/descifrar en tiempo real sería
# mucho más lento en CPU pura.
# ------------------------------------------------------------------------------
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_AES_NI_INTEL=y
